{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1344px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Instrument Sans\", sans-serif",
					"name": "Instrument Sans",
					"slug": "primary"
				},
				{
					"fontFamily": "\"Instrument Sans\", sans-serif",
					"name": "Instrument Sans",
					"slug": "secondary"
				},
				{
					"fontFamily": "monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			]
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"top": "0",
				"right": "clamp(1rem, 3.35vw, 3rem)",
				"bottom": "0",
				"left": "clamp(1rem, 3.35vw, 3rem)"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
